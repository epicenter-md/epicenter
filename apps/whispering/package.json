{
	"name": "@epicenter/whispering",
	"private": true,
	"version": "7.11.1",
	"description": "Browser-deployable speech-to-text SPA hosted natively by Epicenter",
	"exports": {
		"./commands": "./src/lib/commands.ts",
		"./workspace": "./src/lib/workspace/index.ts"
	},
	"imports": {
		"#command-contributions": {
			"epicenter": "./src/lib/commands.tauri.ts",
			"default": "./src/lib/commands.browser.ts"
		},
		"#os": {
			"epicenter": "./src/lib/os/epicenter.ts",
			"default": "./src/lib/os/browser.ts"
		},
		"#shortcuts": {
			"epicenter": "./src/lib/shortcuts/index.epicenter.ts",
			"default": "./src/lib/shortcuts/index.browser.ts"
		},
		"#recording-overlay-surface": {
			"epicenter": "./src/lib/recording-overlay/Surface.epicenter.svelte",
			"default": "./src/lib/recording-overlay/Surface.browser.svelte"
		},
		"#runtime": {
			"epicenter": "./src/lib/runtime/epicenter.ts",
			"default": "./src/lib/runtime/browser.ts"
		},
		"#desktop": {
			"epicenter": "./src/lib/desktop/epicenter.ts",
			"default": "./src/lib/desktop/unavailable.ts"
		},
		"#app-shell": {
			"epicenter": "./src/lib/app-shell/epicenter.svelte",
			"default": "./src/lib/app-shell/browser.svelte"
		},
		"#desktop-promotion": {
			"epicenter": "./src/lib/app-shell/NoDesktopPromotion.svelte",
			"default": "./src/lib/app-shell/DesktopPromotion.svelte"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"test": "bun test",
		"build": "NODE_ENV=production vite build",
		"build:epicenter": "EPICENTER_SURFACE=1 bun run build",
		"check": "bun run typecheck",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.epicenter.json",
		"typecheck:epicenter": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.epicenter.json",
		"typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "wrangler deploy"
	},
	"license": "AGPL-3.0-or-later",
	"devDependencies": {
		"@epicenter/ui": "workspace:*",
		"@epicenter/vite-config": "workspace:*",
		"@types/bun": "catalog:",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/typography": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/js-yaml": "^4.0.9",
		"mode-watcher": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-devtools-json": "^1.0.0",
		"vite-plugin-static-copy": "^4.1.1",
		"wrangler": "catalog:"
	},
	"type": "module",
	"dependencies": {
		"@epicenter/app-shell": "workspace:*",
		"@epicenter/auth": "workspace:*",
		"@epicenter/client": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/field": "workspace:*",
		"@epicenter/recorder": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/workspace": "workspace:*",
		"@mistralai/mistralai": "^1.9.18",
		"@standard-schema/spec": "catalog:",
		"@tanstack/svelte-query": "catalog:",
		"@tanstack/svelte-table": "catalog:",
		"@tanstack/table-core": "9.0.0-alpha.10",
		"@tauri-apps/api": "catalog:",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.0",
		"@tauri-apps/plugin-deep-link": "catalog:",
		"@tauri-apps/plugin-notification": "^2.3.0",
		"@tauri-apps/plugin-os": "^2.3.0",
		"arkregex": "catalog:",
		"arktype": "catalog:",
		"audio-recorder-polyfill": "^0.4.1",
		"bits-ui": "catalog:",
		"date-fns": "catalog:",
		"dexie": "^4.0.11",
		"dompurify": "^3.4.10",
		"elevenlabs": "^1.59.0",
		"fflate": "catalog:",
		"idb": "^8.0.3",
		"js-yaml": "^4.1.1",
		"marked": "catalog:",
		"mime": "catalog:",
		"nanoid": "catalog:",
		"tailwind-variants": "catalog:",
		"typebox": "catalog:",
		"wellcrafted": "catalog:",
		"yjs": "catalog:"
	}
}
