{
	"name": "@epicenter/tab-manager",
	"description": "Browser extension for managing tabs with Epicenter sync and AI chat",
	"version": "0.0.2",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/lib/workspace/index.ts"
	},
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"typecheck": "wxt prepare && svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"@epicenter/agent": "workspace:*",
		"@epicenter/app-shell": "workspace:*",
		"@epicenter/auth": "workspace:*",
		"@epicenter/chat": "workspace:*",
		"@epicenter/client": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/data": "workspace:*",
		"@epicenter/document-sync": "workspace:*",
		"@epicenter/field": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@wxt-dev/storage": "^1.2.6",
		"@y/y": "14.0.0-rc.24",
		"arktype": "catalog:",
		"better-auth": "catalog:",
		"clsx": "catalog:",
		"mode-watcher": "^1.1.0",
		"nanoid": "catalog:",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "catalog:",
		"typebox": "catalog:",
		"virtua": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@standard-schema/spec": "catalog:",
		"@epicenter/api": "workspace:*",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@wxt-dev/module-svelte": "^2.0.3",
		"fake-indexeddb": "^6.2.5",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"wxt": "^0.20.26"
	},
	"license": "AGPL-3.0-or-later"
}
