{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "epicenter-sync-lab",
	"main": "worker/index.ts",
	"compatibility_date": "2026-03-06",
	"compatibility_flags": ["nodejs_compat"],
	"send_metrics": false,

	// THROWAWAY. This app exists to put the transport in front of two real
	// devices on real Cloudflare, which is the only evidence that counts for
	// hibernation and for the storage cap. It is not a product surface and
	// nothing depends on it.

	"assets": { "directory": "./dist", "binding": "ASSETS" },

	"durable_objects": {
		"bindings": [{ "name": "SYNC", "class_name": "SyncLabAuthority" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncLabAuthority"] }],

	"observability": { "enabled": true }
}
