{
	"name": "@epicenter/honeycrisp",
	"description": "Local-first notes app with collaborative rich-text editing",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"exports": {
		".": "./src/lib/workspace/index.ts"
	},
	"imports": {
		"#platform/auth": {
			"epicenter-host": "./src/lib/platform/auth.epicenter-host.ts",
			"tauri": "./src/lib/platform/auth.tauri.ts",
			"default": "./src/lib/platform/auth.browser.ts"
		},
		"#platform/instance": {
			"epicenter-host": "./src/lib/platform/instance.epicenter-host.ts",
			"default": "./src/lib/instance.ts"
		}
	},
	"scripts": {
		"dev": "bun run dev:desktop",
		"dev:web": "vite dev",
		"dev:desktop": "tauri dev",
		"build": "NODE_ENV=production vite build",
		"build:epicenter": "EPICENTER_SURFACE=1 bun run build",
		"preview": "vite preview",
		"deploy": "wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"test": "bun test",
		"tauri": "tauri",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.tauri.json && svelte-check --tsconfig ./tsconfig.epicenter.json",
		"evidence:runs": "bun run evidence/runs-on-the-new-store.ts"
	},
	"devDependencies": {
		"@epicenter/ui": "workspace:*",
		"@epicenter/vite-config": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"fake-indexeddb": "^6.2.5",
		"mode-watcher": "catalog:",
		"playwright": "^1.61.1",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"dependencies": {
		"@epicenter/app-shell": "workspace:*",
		"@epicenter/auth": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/data": "workspace:*",
		"@epicenter/field": "workspace:*",
		"@epicenter/lens": "workspace:*",
		"@epicenter/sqlite": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/sync": "workspace:*",
		"@sqlite.org/sqlite-wasm": "catalog:",
		"@tauri-apps/api": "catalog:",
		"@tauri-apps/plugin-deep-link": "catalog:",
		"@tauri-apps/plugin-opener": "catalog:",
		"@y/prosemirror": "2.0.0-6",
		"@y/y": "14.0.0-rc.24",
		"arktype": "catalog:",
		"better-auth": "catalog:",
		"bits-ui": "catalog:",
		"date-fns": "catalog:",
		"prosemirror-commands": "^1.6.0",
		"prosemirror-inputrules": "^1.4.0",
		"prosemirror-keymap": "^1.2.0",
		"prosemirror-model": "^1.25.0",
		"prosemirror-schema-basic": "^1.2.0",
		"prosemirror-schema-list": "^1.4.0",
		"prosemirror-state": "^1.4.0",
		"prosemirror-view": "^1.41.0",
		"wellcrafted": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
