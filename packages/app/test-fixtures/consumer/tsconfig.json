{
	// Deliberately not this repo's config. It extends nothing, sets no custom
	// conditions, no paths, and no aliases, and it differs from the repo on
	// purpose where a stranger's project would: `verbatimModuleSyntax` is off,
	// and `skipLibCheck` is off so the client's shipped `.d.ts` is actually
	// checked rather than waved through.
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": false,
		"isolatedModules": true,
		"types": []
	},
	"include": ["src"]
}
