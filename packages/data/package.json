{
	"name": "@epicenter/data",
	"version": "0.0.1",
	"description": "The Epicenter store: one document per application, a synchronous surface, and the transport that carries it.",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./bun": "./src/store/bun.ts",
		"./browser": "./src/store/browser.ts",
		"./sync": "./src/sync/index.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test-support.ts"
	],
	"license": "MIT",
	"scripts": {
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.dom.json && tsc --noEmit -p evidence/browser/durable-store/tsconfig.json",
		"test": "bun test"
	},
	"dependencies": {
		"@epicenter/field": "workspace:*",
		"@epicenter/lens": "workspace:*",
		"@epicenter/sqlite": "workspace:*",
		"@epicenter/sync": "workspace:*",
		"@sqlite.org/sqlite-wasm": "catalog:",
		"@y/y": "14.0.0-rc.24",
		"nanoid": "catalog:",
		"typebox": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"playwright": "^1.61.1",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
