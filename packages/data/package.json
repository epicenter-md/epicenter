{
	"name": "@epicenter/data",
	"version": "0.0.1",
	"description": "Local-first scalar data protocol and SQLite replica.",
	"type": "module",
	"exports": {
		".": "./src/store/index.ts",
		"./bun": "./src/store/bun.ts",
		"./browser": "./src/store/browser.ts",
		"./browser-log-worker": "./src/store/browser-log-worker.ts",
		"./sync": "./src/sync/index.ts",
		"./legacy": "./src/index.ts",
		"./legacy/browser": "./src/browser.ts",
		"./legacy/browser-dedicated-worker": "./src/browser-dedicated-worker.ts",
		"./legacy/bun": "./src/bun.ts",
		"./legacy/desktop": "./src/desktop.ts",
		"./legacy/desktop-owner": "./src/desktop-owner.ts",
		"./legacy/inspection": "./src/inspection.ts",
		"./legacy/protocol": "./src/protocol/index.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test-support.ts"
	],
	"license": "MIT",
	"scripts": {
		"evidence:browser": "bun browser-evidence/run.ts --profile smoke",
		"typecheck": "tsc --noEmit && tsc --noEmit -p browser-evidence/tsconfig.json && tsc --noEmit -p evidence/browser/durable-store/tsconfig.json",
		"test": "bun test"
	},
	"dependencies": {
		"@epicenter/field": "workspace:*",
		"@epicenter/lens": "workspace:*",
		"@epicenter/sqlite": "workspace:*",
		"@sqlite.org/sqlite-wasm": "catalog:",
		"@y/y": "14.0.0-rc.24",
		"nanoid": "catalog:",
		"typebox": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"playwright": "^1.61.1",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
