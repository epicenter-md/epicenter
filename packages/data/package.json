{
	"name": "@epicenter/data",
	"version": "0.0.1",
	"description": "The Epicenter store: one document per application, a synchronous surface, and the transport that carries it.",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./definition": "./src/definition/index.ts",
		"./artifact": "./src/artifact/index.ts",
		"./artifact/format": "./src/artifact/format.ts",
		"./artifact/protocol": "./src/artifact/protocol.ts",
		"./artifact/mirror": "./src/artifact/mirror.ts",
		"./engine": "./src/engine.ts",
		"./blobs": "./src/store/blobs.ts",
		"./flush-on-hide": "./src/store/flush-on-hide.ts",
		"./blobs/opfs": "./src/store/blobs.opfs.ts",
		"./memory": "./src/store/memory.ts",
		"./browser": "./src/store/browser.ts",
		"./test-locks": "./src/store/test-locks.ts",
		"./test-opfs": "./src/store/test-opfs.ts",
		"./sync": "./src/sync/index.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test-support.ts"
	],
	"license": "MIT",
	"scripts": {
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.dom.json && tsc --noEmit -p evidence/browser/durable-store/tsconfig.json",
		"test": "bun test"
	},
	"dependencies": {
		"@epicenter/field": "workspace:*",
		"@epicenter/identity": "workspace:*",
		"@epicenter/sqlite": "workspace:*",
		"@epicenter/sync": "workspace:*",
		"@sqlite.org/sqlite-wasm": "catalog:",
		"@y/y": "14.0.0-rc.24",
		"idb": "^8.0.3",
		"nanoid": "catalog:",
		"typebox": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"fake-indexeddb": "^6.2.5",
		"playwright": "^1.61.1",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
