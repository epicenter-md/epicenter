{
	"name": "@epicenter/workspace",
	"version": "0.3.0",
	"description": "Local-first workspace library with schema-opaque records, release-local lenses, and lazy Yjs documents.",
	"keywords": [
		"local-first",
		"CRDT",
		"epicenter",
		"Yjs",
		"offline-first",
		"SQLite",
		"markdown",
		"personal knowledge base",
		"PKM",
		"second brain",
		"sync",
		"workspace",
		"typed schema"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/EpicenterHQ/epicenter.git",
		"directory": "packages/workspace"
	},
	"homepage": "https://epicenter.so",
	"exports": {
		".": "./src/index.ts",
		"./sqlite": "./src/sqlite/index.ts",
		"./sqlite/browser": "./src/sqlite/browser-runtime.ts",
		"./sqlite/browser-worker": "./src/sqlite/browser-runtime-worker.ts",
		"./sqlite/bun": "./src/sqlite/bun-runtime.ts",
		"./sqlite/desktop": "./src/sqlite/desktop-runtime.ts",
		"./sqlite/desktop-owner": "./src/sqlite/desktop-owner.ts",
		"./agent": "./src/agent/index.ts",
		"./markdown": "./src/markdown/index.ts",
		"./document/materializer/markdown": "./src/document/materializer/markdown/index.ts",
		"./daemon": "./src/daemon/index.ts",
		"./node": "./src/node.ts",
		"./document/materializer/sqlite": "./src/document/materializer/sqlite/index.ts",
		"./test-utils": "./src/shared/test-utils.ts",
		"./links": "./src/links.ts",
		"./document/keys": "./src/document/keys.ts",
		"./document/presence": "./src/document/presence-protocol.ts",
		"./document/y-keyvalue/y-keyvalue-lww": "./src/document/y-keyvalue/y-keyvalue-lww.ts",
		"./shared/y-keyvalue/y-keyvalue-lww-encrypted": "./src/shared/y-keyvalue/y-keyvalue-lww-encrypted.ts"
	},
	"license": "MIT",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test",
