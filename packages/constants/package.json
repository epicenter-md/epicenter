		"./oauth-clients": "./src/oauth-clients.ts",
		"./oauth-seed": "./src/oauth-seed.ts",
		"./vite": "./src/vite.ts",
		"./ai-providers": "./src/ai-providers.ts",
		"./api-routes": "./src/api-routes.ts",
		"./oauth-routes": "./src/oauth-routes.ts",
		"./provider-credentials": "./src/provider-credentials.ts"
	},
	"devDependencies": {
		"@better-auth/oauth-provider": "catalog:",
		"@types/bun": "catalog:",
