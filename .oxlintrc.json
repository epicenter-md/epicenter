{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	// Biome is this repo's general linter (see biome.jsonc). Oxlint is here for
	// one job only: run the vendored anti-slop plugin. Every built-in oxlint
	// plugin and category is off so the two linters never disagree about the
	// same code.
	"plugins": [],
	"categories": {
		"correctness": "off"
	},
	"ignorePatterns": [
		// Oxlint already honours .gitignore, so this list only covers checked-in
		// paths that are not application source.
		//
		// `.agents/**` is deliberately absent: this repo keeps owned, tested
		// TypeScript there (`bun test ./.agents/skills/*/scripts/*.test.ts`).
		// Only the vendored plugin asset inside it is skipped.
		".agents/skills/install-anti-slop/**",
		// Symlink mirror of `.agents/skills`; linting it double-reports.
		".claude/**",
		".pi/**",
		// The plugin lints other code; it is not lint subject itself.
		"tools/oxlint/anti-slop/**"
	],
	"jsPlugins": [
		{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }
	],
	"rules": {
		"anti-slop/no-chained-type-assertions": "error",
		"anti-slop/no-conditional-empty-object-spread": "error",
		"anti-slop/no-known-value-widening": "error",
		"anti-slop/no-module-mocking": "error",
		"anti-slop/no-object-parameters": "error",
		"anti-slop/no-reflect-apply": "error",
		"anti-slop/no-reflect-get": "error",
		"anti-slop/no-runtime-typeof": "error",
		"anti-slop/no-shape-in-symbol-names": "error",
		"anti-slop/no-unknown-parameters": "error",
		"anti-slop/no-unknown-returns": "error",
		"anti-slop/no-unknown-type-aliases": "error",
		"anti-slop/no-unsafe-dictionary-type": "error",
		"anti-slop/no-widen-then-assert": "error",
		"anti-slop/require-safety-comment-for-type-assertion": "error"
	}
}
